[Desktop Entry]
Type=Application
Name=OpenSheet
GenericName=Spreadsheet
GenericName[fr]=Tableur
GenericName[es]=Hoja de cálculo
GenericName[de]=Tabellenkalkulation
GenericName[it]=Foglio di calcolo
